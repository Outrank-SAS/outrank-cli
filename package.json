{
  "name": "outrank-cli",
  "version": "0.5.0",
  "description": "Agent-first CLI and MCP server for the Outrank agent API",
  "type": "module",
  "files": [
    "bin",
    "src",
    "README.md",
    "SKILL.md",
    "LICENSE"
  ],
  "bin": {
    "outrank-cli": "./bin/outrank-cli.js",
    "outrank-mcp": "./bin/outrank-mcp.js"
  },
  "scripts": {
    "start": "node ./src/index.js",
    "help": "node ./src/index.js --help",
    "lint": "eslint .",
    "test": "node --test",
    "golden:capture": "node ./scripts/captureGolden.js",
    "docs:tools": "node ./scripts/generateToolDocs.js",
    "link:local": "npm link",
    "unlink:local": "npm unlink -g outrank-cli"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "globals": "^15.0.0"
  },
  "keywords": [
    "outrank",
    "cli",
    "agent",
    "mcp",
    "model-context-protocol",
    "seo",
    "content",
    "ai"
  ],
  "author": "Outrank SAS",
  "license": "MIT",
  "homepage": "https://www.outrank.so",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Outrank-SAS/outrank-cli.git"
  },
  "bugs": {
    "url": "https://www.outrank.so"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.31.0",
    "zod": "4.6.5"
  }
}
